#!/usr/bin/env python3
"""Land a proven pull request by pushing its head to its base.

    bin/merge-pr <number> [--dry-run] [--stacked]

This history is public, and carries no identity but its authors' own. Every
way GitHub merges writes a commit of its own under the account that lands it:
a merge or squash commit is authored by that account, and a rebase makes it
each commit's committer and drops the signature. So nothing here lands
through GitHub's merge. The head already contains its base's tip and holds no
merge commit, so it is a fast-forward of the base: pushing it lands exactly
the signed, reviewed commits, and GitHub marks the pull request merged. A
merge queue would merge through GitHub, so a base whose rules require one is
refused.

It acts only when all of these hold; otherwise it refuses, says why and what
fixes it, and exits 1:

1. The pull request is open, is not a draft, and its base is the default
   branch. Another base is refused unless `--stacked` says it is meant: a
   stacked pull request once merged into a base that had gone stale, and its
   change never reached master (#196).
2. Its head contains its base's current tip, so the checks ran on what the
   base becomes, and the push is a fast-forward.
3. GitHub says it merges cleanly.
4. Its head has checks, and every one finished as passed, skipped or neutral.
   No checks at all is a refusal: a conflicting pull request gets no CI.
5. Every workflow run its pull request started on that head has finished as
   passed, skipped or neutral, and each of REQUIRED_WORKFLOWS has one. The
   checks alone are not enough: a workflow still waiting for a runner has no
   jobs, so it has no checks, and a head whose Desk tests finished while
   elixir sat queued once read as all passed (#396, 2026-11-02). A required
   workflow that is queued or missing is a wait, never a pass.
6. Each review the diff requires has a successful sign-off on the head
   itself. A rebase makes new commits, so a sign-off never carries over.
7. Its commits are none of them merges, and GitHub verifies every one's
   signature: bring a branch up to date by rebasing it, not by merging its
   base in.
8. The private deny check (bin/private-check) passes over its commits and
   its tree.

The push is plain, never forced, so a base that moved since it was judged
refuses it, and the pre-push hook checks it again. Once pushed, the pull
request must read as merged and the base's tip must be the head. `--dry-run`
judges and pushes nothing. Needs `gh`, logged in, and `git`, run in a checkout
whose `origin` is this repository.
"""

import argparse
import json
from pathlib import Path
import subprocess
import sys
import time

FIELDS = "id,number,url,state,isDraft,baseRefName,headRefOid,mergeable,statusCheckRollup"
PASSED = {"SUCCESS", "SKIPPED", "NEUTRAL"}
# The workflows every pull request runs, by their `name:`.
REQUIRED_WORKFLOWS = ("connector", "checks")
# The paths whose change needs an architecture review: what this repository
# publishes for the server and the Mac to read (contract/client/ and its
# generator), the phone's API into the Connector, the status file the Mac
# reads, and the checks that guard the rest, so that no pull request weakens
# a check it would fail: the workflows, the hooks, these rules, the scope
# and privacy checks and their reviewed exceptions. Server-owned contract/
# paths change only through the publishing pull request (bin/publisher-scope).
ARCHITECTURE_PATHS = ("contract/client/", "connector/cmd/clientcontract/", "connector/phonenode/",
                      "connector/internal/status/", "connector/internal/state/status.go",
                      ".github/", ".githooks/", "bin/merge-pr", "bin/sign-off", "bin/publisher-scope",
                      "bin/private-check", "bin/contract-check", "bin/contract-check-allow.json")
UI_PATHS = ("phone/ios/App/",)
RUN_FIELDS = "databaseId,workflowName,status,conclusion,createdAt"


def run(*args):
    done = subprocess.run(args, capture_output=True, text=True)
    if done.returncode != 0:
        sys.exit(f"bin/merge-pr: `{' '.join(args)}` failed: {done.stderr.strip()}")
    return done.stdout.rstrip("\n")


def ancestor(older, newer):
    done = subprocess.run(["git", "merge-base", "--is-ancestor", older, newer],
                          capture_output=True, text=True)
    if done.returncode not in (0, 1):
        sys.exit(f"bin/merge-pr: cannot check ancestry: {done.stderr.strip()}")
    return done.returncode == 0


def git_file(tree, path):
    """Absent files are optional; failed tree/blob reads are not absence."""
    paths = run("git", "ls-tree", "-r", "--name-only", "-z", tree, "--", path).split("\0")
    return run("git", "show", f"{tree}:{path}") if path in paths else None


def needed_sign_offs(paths, before, after):
    """The review kinds the changed paths require."""
    needed = set()
    for path in paths:
        if path.startswith(ARCHITECTURE_PATHS):
            needed.add("architecture")
        if path.startswith(UI_PATHS):
            needed.add("ui")
    return needed


def private_refusals(head, merge_base):
    """The private deny check over the head, on the machines that have one (bin/private-check)."""
    check = Path(__file__).resolve().with_name("private-check")
    done = subprocess.run([str(check), ".", head, merge_base], capture_output=True, text=True)
    if done.returncode == 0:
        return []
    detail = '; '.join(done.stderr.strip().splitlines()) or 'no detail'
    return [f"the private deny check refused its head: {detail}"]


def merge_commits(merge_base, head):
    """The pull request's own merge commits: a branch is brought up to date by rebasing."""
    return run("git", "rev-list", "--merges", f"{merge_base}..{head}").split()


def unverified(repo, merge_base, head):
    """Its commits whose signature GitHub does not verify."""
    return [commit for commit in run("git", "rev-list", f"{merge_base}..{head}").split()
            if run("gh", "api", f"repos/{repo}/commits/{commit}", "--jq", ".commit.verification.verified") != "true"]


def landed(number, base, head, wait=time.sleep):
    """Why the pushed pull request has not landed as its head; empty when it has."""
    run("git", "fetch", "--quiet", "origin", f"+refs/heads/{base}:refs/remotes/origin/{base}")
    tip = run("git", "rev-parse", f"origin/{base}")
    if tip != head:
        return [f"{base}'s tip is {tip[:9]}, not the head {head[:9]}"]
    for _ in range(12):
        if run("gh", "pr", "view", str(number), "--json", "state", "--jq", ".state") == "MERGED":
            return []
        wait(5)
    return ["GitHub has not marked it merged after a minute"]


def branch_rules(repo, base):
    """The base's active rules: none while the plan gives a private repository none."""
    done = subprocess.run(["gh", "api", f"repos/{repo}/rules/branches/{base}"],
                          capture_output=True, text=True)
    if done.returncode != 0 and "Upgrade to GitHub Pro or make this repository public" in done.stdout:
        return []
    if done.returncode != 0:
        sys.exit(f"bin/merge-pr: cannot read {base}'s rules: {done.stderr.strip()}")
    return json.loads(done.stdout)


def head_statuses(repo, head):
    pages = json.loads(run("gh", "api", "--paginate", "--slurp",
                           f"repos/{repo}/commits/{head}/statuses?per_page=100"))
    return [status for page in pages for status in page]


def found_sign_offs(needed, statuses):
    """Each kind's newest sign-off on the head, withdrawals included."""
    found = {}
    for status in statuses:  # GitHub returns newest first, across pages.
        kind = status["context"].removeprefix("sign-off/")
        if status["context"].startswith("sign-off/") and kind in needed:
            found.setdefault(kind, status["state"])
    return found


def sign_off_refusals(needed, found, number, head):
    return [f"missing successful {kind} sign-off: ask for {'an' if kind == 'architecture' else 'a'} "
            f"{kind} review of {head[:9]}; the reviewer runs "
            f"`bin/sign-off {number} {kind} --sha {head} --session <reviewer-session-id>`"
            for kind in sorted(needed) if found.get(kind) != "success"]


def check_state(check):
    """A check's name and how it stands: its conclusion, or PENDING until it has one."""
    if check.get("__typename") == "StatusContext":
        return check.get("context", "?"), check.get("state") or "PENDING"
    if check.get("status") != "COMPLETED":
        return check.get("name", "?"), "PENDING"
    return check.get("name", "?"), check.get("conclusion") or "PENDING"


def latest_runs(runs):
    """Each workflow's newest run: a later push or re-run supersedes an earlier one."""
    newest = {}
    for run in runs:
        name = run.get("workflowName") or "?"
        if name not in newest or (run.get("databaseId") or 0) > (newest[name].get("databaseId") or 0):
            newest[name] = run
    return newest


def run_refusals(runs, required=REQUIRED_WORKFLOWS):
    """Why the workflow runs on a head do not yet prove it, each with its fix; empty when they do.

    `runs` are `gh run list --commit <head> --event pull_request --json RUN_FIELDS`.
    """
    said = []
    newest = latest_runs(runs)
    missing = sorted(name for name in required if name not in newest)
    if missing:
        said.append(f"no run yet of {', '.join(missing)} on its head: wait for it to start and finish")
    waiting = sorted(name for name, run in newest.items() if run.get("status") != "completed")
    failed = sorted(f"{name} ({(run.get('conclusion') or '?').lower()})" for name, run in newest.items()
                    if run.get("status") == "completed"
                    and (run.get("conclusion") or "").upper() not in PASSED)
    if waiting:
        said.append(f"workflows still queued or running: {', '.join(waiting)}: wait for them")
    if failed:
        said.append(f"workflows not passed: {', '.join(failed)}: fix them and push")
    return said


def head_runs(head):
    """The workflow runs a pull request started on `head`."""
    return json.loads(run("gh", "run", "list", "--commit", head, "--event", "pull_request",
                          "--limit", "100", "--json", RUN_FIELDS))


def queue_required(rules):
    """Whether a branch's active rules (`gh api repos/:repo/rules/branches/:base`) require a merge queue."""
    return any(rule.get("type") == "merge_queue" for rule in rules or [])


def refusals(pr, default_branch, has_base_tip, stacked=False):
    """Why `pr` may not land yet, each with its fix; empty when it may."""
    said = []
    if pr["state"] != "OPEN":
        said.append(f"it is {pr['state'].lower()}, not open")
        return said
    if pr["isDraft"]:
        said.append("it is a draft: mark it ready for review")
    base = pr["baseRefName"]
    if base != default_branch and not stacked:
        said.append(
            f"its base is {base}, not {default_branch}: retarget it to {default_branch}, "
            "or pass --stacked if merging into the branch below is meant"
        )
    if not has_base_tip:
        said.append(f"its head does not contain the current {base}: rebase it onto {base}, resolve any conflicts, push with --force-with-lease, and wait for CI")
    if pr["mergeable"] != "MERGEABLE":
        if pr["mergeable"] == "UNKNOWN":
            said.append("GitHub has not worked out whether it merges cleanly yet: try again in a minute")
        else:
            said.append(f"GitHub says it is {pr['mergeable'].lower()}: rebase it onto {base}, resolve any conflicts, push with --force-with-lease, and wait for CI")
    checks = [check_state(check) for check in pr.get("statusCheckRollup") or []]
    if not checks:
        said.append("its head has no checks, which is what a conflicting or unbuilt head gets: push, and wait for CI")
    pending = sorted(name for name, state in checks if state in {"PENDING", "QUEUED", "IN_PROGRESS", "EXPECTED"})
    failed = sorted(f"{name} ({state.lower()})" for name, state in checks
                    if state not in PASSED and name not in pending)
    if pending:
        said.append(f"checks still running: {', '.join(pending)}: wait for them")
    if failed:
        said.append(f"checks not passed: {', '.join(failed)}: fix them and push")
    return said


def main():
    parser = argparse.ArgumentParser(description="Merge a pull request only once it is proven against its base.")
    parser.add_argument("number", type=int)
    parser.add_argument("--dry-run", action="store_true", help="judge it and merge nothing")
    parser.add_argument("--stacked", action="store_true", help="allow a base other than the default branch")
    args = parser.parse_args()

    pr = json.loads(run("gh", "pr", "view", str(args.number), "--json", FIELDS))
    default_branch = run("gh", "repo", "view", "--json", "defaultBranchRef", "--jq", ".defaultBranchRef.name")
    base, head = pr["baseRefName"], pr["headRefOid"]
    # The base's tip as it is now, and the head as GitHub has it, whatever is checked out here.
    run("git", "fetch", "--quiet", "origin",
        f"+refs/heads/{base}:refs/remotes/origin/{base}", f"refs/pull/{args.number}/head")
    has_base_tip = ancestor(f"origin/{base}", head)
    merge_base = run("git", "merge-base", f"origin/{base}", head)
    # Disabling rename detection exposes both the deleted and added paths.
    paths = run("git", "diff", "--no-renames", "--name-only", "-z", merge_base, head).split("\0")
    needed = needed_sign_offs([path for path in paths if path],
                             lambda path: git_file(merge_base, path),
                             lambda path: git_file(head, path))

    repo = run("gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner")
    rules = branch_rules(repo, base)
    queue = queue_required(rules)
    found = found_sign_offs(needed, head_statuses(repo, head)) if needed else {}
    said = refusals(pr, default_branch, has_base_tip, args.stacked) + \
        run_refusals(head_runs(head)) + sign_off_refusals(needed, found, args.number, head) + \
        private_refusals(head, merge_base)
    if queue:
        said.append(f"{base}'s rules require a merge queue, which lands through GitHub's merge: "
                    "remove the queue; pull requests here land by push")
    merges = merge_commits(merge_base, head)
    if merges:
        said.append(f"it holds merge commits ({', '.join(sha[:9] for sha in merges)}): "
                    f"rebase it onto {base}, resolve any conflicts, push with --force-with-lease, and wait for CI")
    unsigned = unverified(repo, merge_base, head)
    if unsigned:
        said.append(f"GitHub does not verify the signature of {', '.join(sha[:9] for sha in unsigned)}: "
                    "sign every commit, and push")
    print(f"#{pr['number']} {pr['url']}\n  head {head[:9]} into {base}")
    if said:
        print("refused:")
        for reason in said:
            print(f"  - {reason}")
        sys.exit(1)
    if args.dry_run:
        print(f"would push {head[:9]} to {base}: every condition holds (--dry-run)")
        return
    run("git", "push", "--quiet", "origin", f"{head}:refs/heads/{base}")
    wrong = landed(args.number, base, head)
    if wrong:
        sys.exit("bin/merge-pr: pushed, but " + "; ".join(wrong))
    print(f"merged: {head}")


if __name__ == "__main__":
    main()
