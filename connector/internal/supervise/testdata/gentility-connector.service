[Unit]
Description=Gentility connector (ai.gentility.connector)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/connector serve --state-dir /var/lib/gentility
Restart=on-failure
RestartPreventExitStatus=2 3 4 5
RestartSec=2
User=gentility
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gentility /var/log/gentility

[Install]
WantedBy=multi-user.target
