[
  {
    "name": "later insertion withdraws a colliding placed row",
    "steps": [
      {
        "expected": [
          {
            "content": "first",
            "kind": "message",
            "position": 1,
            "turn": 1
          },
          {
            "content": {
              "from": "claude",
              "to": "codex"
            },
            "kind": "handoff",
            "position": 2,
            "turn": 1
          }
        ],
        "facts": [
          {
            "event_type": "transcript_updated",
            "payload": {
              "complete": true,
              "content": "first",
              "id": "0199f000-0000-7000-8000-000000000011",
              "kind": "message",
              "operation": "replace",
              "position": 1,
              "role": "assistant",
              "turn": 1
            }
          },
          {
            "event_type": "handoff_prepared",
            "payload": {
              "from": "claude",
              "position": 2,
              "to": "codex",
              "turn": 1
            }
          }
        ]
      },
      {
        "expected": [
          {
            "content": "first",
            "kind": "message",
            "position": 1,
            "turn": 1
          },
          {
            "content": "second",
            "kind": "message",
            "position": 2,
            "turn": 1
          }
        ],
        "facts": [
          {
            "event_type": "transcript_updated",
            "payload": {
              "complete": true,
              "content": "second",
              "id": "0199f000-0000-7000-8000-000000000012",
              "kind": "message",
              "operation": "replace",
              "position": 2,
              "role": "assistant",
              "turn": 1
            }
          }
        ]
      }
    ]
  },
  {
    "name": "implicit configuration position uses insertion order not last change",
    "steps": [
      {
        "expected": [
          {
            "content": "after",
            "kind": "message",
            "position": 1,
            "turn": 1
          },
          {
            "content": {
              "from": "supervised",
              "to": "auto_accept_edits"
            },
            "kind": "mode_changed",
            "position": 2,
            "turn": 1
          }
        ],
        "facts": [
          {
            "event_type": "turn_started",
            "payload": {
              "turn": 1
            }
          },
          {
            "event_type": "transcript_updated",
            "payload": {
              "complete": true,
              "content": "before",
              "id": "0199f000-0000-7000-8000-000000000021",
              "kind": "message",
              "operation": "replace",
              "position": 1,
              "role": "assistant",
              "turn": 1
            }
          },
          {
            "event_type": "mode_changed",
            "payload": {
              "mode": "auto_accept_edits"
            }
          },
          {
            "event_type": "transcript_updated",
            "payload": {
              "complete": true,
              "content": "after",
              "id": "0199f000-0000-7000-8000-000000000021",
              "kind": "message",
              "operation": "replace",
              "position": 1,
              "role": "assistant",
              "turn": 1
            }
          }
        ]
      }
    ]
  },
  {
