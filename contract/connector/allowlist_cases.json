        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": ".code.example.com",
      "permitted": false
    },
    {
      "note": "the root alone",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": ".",
      "permitted": false
    },
    {
      "note": "a leading space",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": " api.code.example.com",
      "permitted": false
    },
    {
      "note": "a trailing space",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "api.code.example.com ",
      "permitted": false
    },
    {
      "note": "an embedded newline",
      "patterns": [
