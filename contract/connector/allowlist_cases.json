{
  "permits": [
    {
      "note": "an exact host",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "registry.example.org",
      "permitted": true
    },
    {
      "note": "one label under a wildcard",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "api.code.example.com",
      "permitted": true
    },
    {
      "note": "an internal hyphen is a legal label",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "ap-i.code.example.com",
      "permitted": true
    },
    {
      "note": "the apex is not what a wildcard said",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "code.example.com",
      "permitted": false
    },
    {
      "note": "a wildcard does not walk down the tree",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "deep.api.code.example.com",
      "permitted": false
    },
    {
      "note": "a suffix is not a substring",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "evil-code.example.com",
      "permitted": false
    },
    {
      "note": "nor a prefix",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "notcode.example.com",
      "permitted": false
    },
    {
      "note": "ASCII case is spelling",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "REGISTRY.EXAMPLE.ORG",
      "permitted": true
    },
    {
      "note": "an allowlisted IP literal",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "203.0.113.7",
      "permitted": true
    },
    {
      "note": "an IP literal that is not allowlisted",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "203.0.113.8",
      "permitted": false
    },
    {
      "note": "the empty host",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "",
      "permitted": false
    },
    {
      "note": "one root dot on an exact host",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "registry.example.org.",
      "permitted": true
    },
    {
      "note": "one root dot under a wildcard",
      "patterns": [
