        "*.bad_suffix.example.com"
      ],
      "host": "%2e.code.example.com",
      "permitted": false
    },
    {
      "note": "an underscore",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "api_1.code.example.com",
      "permitted": false
    },
    {
      "note": "a leading hyphen",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "-api.code.example.com",
      "permitted": false
    },
    {
      "note": "a trailing hyphen",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "api-.code.example.com",
      "permitted": false
    },
    {
      "note": "a Unicode fold of an allowlisted host (KELVIN SIGN)",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "\u212aelvin.example",
      "permitted": false
    },
    {
      "note": "a fullwidth letter under a wildcard",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "\uff41pi.code.example.com",
      "permitted": false
    },
    {
      "note": "the literal it would have folded to",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "kelvin.example",
      "permitted": true
    },
    {
      "note": "a 63-byte label",
      "patterns": [
        "*.code.example.com"
      ],
      "host": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.code.example.com",
      "permitted": true
    },
    {
      "note": "a 64-byte label",
      "patterns": [
        "*.code.example.com"
      ],
      "host": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.code.example.com",
      "permitted": false
    },
    {
      "note": "a 253-byte name",
      "patterns": [
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      ],
      "host": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "permitted": true
    },
    {
      "note": "a 254-byte name, allowlisted or not",
      "patterns": [
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      ],
      "host": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "permitted": false
    },
    {
      "note": "a wildcard whose own suffix is not a hostname",
      "patterns": [
        "registry.example.org",
        "*.code.example.com",
        "203.0.113.7",
        "kelvin.example",
        "*.bad_suffix.example.com"
      ],
      "host": "api.bad_suffix.example.com",
      "permitted": false
    },
    {
      "note": "an empty allowlist permits nothing",
      "patterns": [],
      "host": "registry.example.org",
      "permitted": false
    }
  ],
  "literal": [
    {
      "note": "a dotted-quad IPv4 literal",
      "pattern": "203.0.113.7",
      "elixir": true,
      "go": true
    },
    {
      "note": "an IPv6 literal",
      "pattern": "2001:db8::1",
      "elixir": true,
      "go": true
    },
    {
      "note": "a wildcard is not a literal",
      "pattern": "*.code.example.com",
      "elixir": false,
      "go": false
    },
    {
      "note": "a hostname is not a literal",
      "pattern": "example.com",
      "elixir": false,
      "go": false
    },
    {
      "note": "brackets are the URL-authority form; neither side parses them raw",
      "pattern": "[::1]",
      "elixir": false,
      "go": false
    },
    {
      "note": "hex inet form: Erlang accepts, netip refuses",
      "pattern": "0x7f.0.0.1",
      "elixir": true,
      "go": false
    },
    {
      "note": "abbreviated inet form: Erlang accepts, netip refuses",
      "pattern": "127.1",
      "elixir": true,
      "go": false
    },
    {
      "note": "octal inet form: Erlang accepts, netip refuses",
      "pattern": "010.0.0.1",
      "elixir": true,
      "go": false
    },
    {
      "note": "bare 32-bit integer: Erlang accepts, netip refuses",
      "pattern": "2130706433",
      "elixir": true,
      "go": false
    }
  ]
}
